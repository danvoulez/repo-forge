# Copy to github-queue.env (ignored by git) and edit.
#
# GH_FORGE_ISSUE_REPO=OWNER/REPO
GH_FORGE_ISSUE_REPO=danvoulez/repo-forge

# Strongly recommended (comma-separated GitHub usernames)
GH_FORGE_ISSUE_ALLOWED_AUTHORS=danvoulez

# Which checkout repo-forge edits (defaults to repo-forge install dir)
# REPO_FACTORY_CWD=/path/to/your/project

# Poll interval seconds (optional)
# GH_FORGE_ISSUE_POLL_INTERVAL=45
